# Copy this file to .env and fill in your values.
# .env is gitignored and must stay that way.

# Anthropic — required for categorisation and PDF/CSV parsing.
# The dashboard still starts without it; only LLM features fail.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ---------------------------------------------------------------------------
# Trading 212
# ---------------------------------------------------------------------------
# Generate a key per account in the app: Settings > API.
# Tick at least: Account data, Portfolio, History - Transactions,
# History - Dividends. If you restrict by IP, use your PUBLIC IP.
#
# Trading 212 issues ONE key pair per account, so Invest and Stocks ISA need
# separate keys. It does not tell you which account a key belongs to -- the
# sync detects that from your holdings and warns if these names disagree.
T212_API_KEY_INVEST=
T212_API_SECRET_INVEST=
T212_API_KEY_STOCKS_ISA=
T212_API_SECRET_STOCKS_ISA=

# live | demo. Keys only work in the environment they were created in.
T212_ENV=live

# ---------------------------------------------------------------------------
# Optional overrides (defaults are repo-relative)
# ---------------------------------------------------------------------------
# DB_PATH=./data/bookkeeping.db
# INPUT_DIR=./data/input

# ---------------------------------------------------------------------------
# Monzo (the only UK bank here with an API an individual can use)
# ---------------------------------------------------------------------------
# Register a *confidential* OAuth client at https://developers.monzo.com/.
# Non-confidential clients are issued no refresh token, which means re-linking
# by hand every few hours.
#
# Set the client's redirect URL to exactly MONZO_REDIRECT_URI below.
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8000/api/banks/monzo/callback

# ---------------------------------------------------------------------------
# Enable Banking -- DORMANT, do not bother filling in
# ---------------------------------------------------------------------------
# Covers the EEA only (30 markets, Austria to Sweden). The UK is not among
# them, so it reaches none of the accounts this app tracks. The client is kept
# in backend/integrations/enablebanking.py in case that changes.
# EB_APPLICATION_ID=
