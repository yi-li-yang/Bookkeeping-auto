{
  "name": "bookkeeping-auto",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/py.mjs -m pip install -r backend/requirements.txt && npm --prefix frontend install",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/py.mjs -m uvicorn backend.main:app --reload --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "serve": "node scripts/py.mjs -m uvicorn backend.main:app --port 8000",
    "start": "npm run build && npm run serve",
    "test": "node scripts/py.mjs -m pytest backend/tests -q"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
